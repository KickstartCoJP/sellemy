<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kickstart.sellemy-periodic-quality-review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/kickstart/sellemy/.venv/bin/python</string>
    <string>/Users/kickstart/sellemy/pipeline/periodic_quality_review.py</string>
  </array>
